snr_og_dataframe_labelled = pd.concat([snr_og_dataframe_labelled], keys=['SNR of Original X-Ray'], axis=1)
print(snr_og_dataframe_labelled)

# CNR Results dataframe for DF and OG:
material_comp = ['Lung-Air', 'Lung-Plastic']
cnr_df_dataframe = pd.DataFrame(cnr_results_df, [diffusers_of_image_pairs], [material_comp])
cnr_df_dataframe_labelled = pd.concat([pd.concat([cnr_df_dataframe], keys=['Materials Compared'], axis=1)], keys=['Diffuser'])
cnr_df_dataframe_labelled = pd.concat([cnr_df_dataframe_labelled], keys=['CNR of Dark Field Image'], axis=1)
print(cnr_df_dataframe_labelled)

cnr_og_dataframe = pd.DataFrame(cnr_results_og, [diffusers_of_image_pairs], [material_comp])
