import numpy as np
from matplotlib import pyplot as plt
import tifffile
import os
import pandas as pd



# Fetch directory with data files
directory_file_path = input("Please input the absolute file path of the directory in which your data files are located: ")
# Function to search for specific files in a directory. Returns a list of filenames that contain any of the strings in the input list
def get_file_names_with_strings(str_list):
    full_list = os.listdir(directory_file_path) # Directory where DF and OG TIFF files are stored
    final_list = [] # Initialise to concatonate
    for file in full_list:
        filename = os.fsdecode(file)
        for string in str_list:
            if string in filename:
                final_list = final_list + [filename]
            elif string not in filename:
                exit("There is no image pair with that string in this directory. Please check your inputs or your files.")

    return final_list

